{
  "name": "farming",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && vite build --config vite.truck.config.ts",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:truck": "vite --config vite.truck.config.ts",
    "build:truck": "tsc --noEmit && vite build --config vite.truck.config.ts"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
